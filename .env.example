# Copy the lines you need into server/.env or client/.env, or export them.
# Every value has a working default for local development.

# --- server ---
PORT=4000
DATABASE_PATH=data/activity.sqlite3
CORS_ORIGIN=http://localhost:5176
# Required in production (32+ characters); the placeholder below is always refused. In development a random secret is generated per run.
TOKEN_SECRET=replace-with-a-long-random-string
# Demo simulator: "on" or "off", and how often it posts (milliseconds)
SIMULATOR=on
SIMULATOR_INTERVAL_MS=6000

# --- client (Vite) ---
VITE_API_URL=http://localhost:4000/graphql
