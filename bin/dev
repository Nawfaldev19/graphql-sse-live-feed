#!/usr/bin/env bash
# One-command local start: installs dependencies (inside this folder only),
# then runs the API on :4000 (with the demo simulator) and the web app on :5176.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v node >/dev/null 2>&1 || { echo "Missing Node.js 20 or newer (see README)." >&2; exit 1; }

echo "==> Installing server packages"
(cd server && npm install --no-audit --no-fund --silent)
echo "==> Installing client packages"
(cd client && npm install --no-audit --no-fund --silent)

echo "==> Starting API on http://localhost:4000/graphql and web app on http://localhost:5176"
trap 'kill 0' EXIT INT TERM
(cd server && npm run dev) &
(cd client && npm run dev) &
wait
